#!/bin/sh
# Plays Colin McRae Rally 2005 on Linux through Wine and gamescope, using the
# rea-launcher-sdk play library (sdk/rea-play.sh; see its shell/README.md).
#
#   cmr2005-play             show the settings window, then start the game
#   cmr2005-play --play      start with the saved settings (no window)
#   cmr2005-play stop        end the game session and its private Wine prefix
#   cmr2005-play status      running or idle
#
# Optional environment:
#   CMR2005_PREFIX    Wine prefix (default ~/.local/share/cmr2005-launcher/prefix)
#   CMR2005_LAUNCHER  CMR2005Launcher.exe (default: next to this script, or one up)
#   CMR2005_RUN       a wrapper that runs wine and gamescope, e.g.
#                      "distrobox enter gaming --" when they live in a container
#   CMR2005_WAIT      set by the AppImage (every launch waits anyway)
#   CMR2005_GPU       GPU environment to use instead of the detected one
set -u

# --- the library: next to this script in a package, else the vendored copy --
# Tests source this script with REA_FUNCTIONS_ONLY=1 (load, don't run) and
# REA_PLAY_HERE=<this script's folder> ($0 is then the test). REA_PLAY_HERE
# counts only in that mode; the library drops both once sourced.
_fonly=${REA_FUNCTIONS_ONLY:-}
_here=$(dirname "$(readlink -f "$0")")
[ "$_fonly" = 1 ] && [ -n "${REA_PLAY_HERE:-}" ] && _here=$REA_PLAY_HERE
if [ -f "$_here/rea-play.sh" ]; then
  . "$_here/rea-play.sh"
elif [ -f "$_here/../sdk/rea-play.sh" ]; then
  . "$_here/../sdk/rea-play.sh"
else
  echo "rea-play.sh not found next to $0 or in ../sdk (run scripts/sdk-sync)" >&2
  exit 1
fi
REA_HERE=$_here REA_NAME=cmr2005-play

# --- configuration (after sourcing: inherited REA_* values are dropped, so
# only the player-facing CMR2005_* names below reach the library) ----------
REA_APP=cmr2005-launcher                 # ~/.config/cmr2005-launcher, the prefix name
REA_EXE_NAME=CMR2005Launcher.exe
REA_EXE_HINT=CMR2005_LAUNCHER
REA_EXE=${CMR2005_LAUNCHER:-}
REA_PREFIX=${CMR2005_PREFIX:-}
REA_RUN=${CMR2005_RUN:-}
REA_WAIT=${CMR2005_WAIT:-}
[ -n "${CMR2005_GPU+set}" ] && REA_GPU=$CMR2005_GPU   # CMR2005_GPU= for no GPU choice
REA_CFG_APPDATA=CMR2005Launcher       # AppData\Local\CMR2005Launcher\launcher.cfg
REA_WINEDBG_OFF=1                     # a fault ends the game, no hidden debugger
REA_ORIGINAL_SIZE=640x480             # the game's own mode on its first start
REA_SCALER_KEY=                       # no scaler option: gamescope's default
REA_LEGACY_LOCK=off                   # no older helper wrote a pid-only lock
REA_HELPER_KEYS="look resolution"     # --look/--resolution size gamescope too
# DXVK's d3d9 override is the launcher's (Wine's per-program key for
# cmr5.exe): Wine ignores WINEDLLOVERRIDES in the game's environment.

# The gamescope size a look gives (the launcher's Look::picture in
# src/config.rs): Widescreen and Steam Deck the screen, inside which the
# launcher picks its 16:9 size as it does on a real screen (1280x720 on a
# Deck's 1280x800); Original the game's own mode.
cmr2005_look_size() {
  case $1 in
    widescreen) rea_screen_size || echo 1920x1080 ;;
    steam_deck) echo 1280x800 ;;
    original) echo original ;;
    *) return 1 ;;
  esac
}

# --- game hooks --------------------------------------------------------------

# A look fills the resolution its own source (launcher.cfg, or this run's
# flags) left unset, and flags win over the file, as in the launcher. The
# size goes into this run's values, which rea_game_size reads first.
rea_hook_before_start() {
  rea_wine_no_crash_dialog
  [ -n "$(REA_CFG=; rea_get_key resolution)" ] && return 0
  _cmr2005_size=
  _cmr2005_look=$(REA_CFG=; rea_get_value look)
  if [ -n "$_cmr2005_look" ]; then
    _cmr2005_size=$(cmr2005_look_size "$_cmr2005_look") || _cmr2005_size=
  fi
  if [ -z "$_cmr2005_size" ] && [ -n "$REA_CFG" ] &&
    [ -z "$(rea_get_key resolution "$REA_CFG")" ]; then
    _cmr2005_look=$(rea_get_value look "$REA_CFG")
    [ -n "$_cmr2005_look" ] && { _cmr2005_size=$(cmr2005_look_size "$_cmr2005_look") || _cmr2005_size=; }
  fi
  # No look and no resolution anywhere (no launcher.cfg yet): the
  # launcher's first start saves the Widescreen look.
  if [ -z "$_cmr2005_size" ] && [ -z "$_cmr2005_look" ] &&
    { [ -z "$REA_CFG" ] || [ -z "$(rea_get_key resolution "$REA_CFG")" ]; }; then
    _cmr2005_size=$(cmr2005_look_size widescreen)
  fi
  [ -n "$_cmr2005_size" ] || return 0
  REA_ONE_RUN="${REA_ONE_RUN:+$REA_ONE_RUN
}resolution=$_cmr2005_size"
}

rea_init || exit 1
# Tests load the configuration and hooks without running anything.
[ "$_fonly" = 1 ] && return 0
rea_main "$@"
